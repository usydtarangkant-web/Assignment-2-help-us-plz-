#include "compass.h"
#include <math.h>


/* Compass I2C address */
#define COMPASS_ADDR 0x1E


/* Compass register addresses */
#define CRA_REG_M   0x00
#define CRB_REG_M   0x01
#define MR_REG_M    0x02
#define OUT_X_H_M   0x03


/* Global tick counter */
extern volatile uint32_t tick_ms;


/* Wait for I2C flag with timeout */
int waitSet(uint32_t flag, uint32_t to)
{
    uint32_t start = tick_ms;

    while (!(I2C1->ISR & flag))
    {
        if ((tick_ms - start) >= to)
        {
            return -1;
        }
    }

    return 0;
}


/* Initialise I2C peripheral */
void i2cInit(void)
{
    RCC->AHBENR |= RCC_AHBENR_GPIOBEN;
    RCC->APB1ENR |= RCC_APB1ENR_I2C1EN;


    /* Set PB6/PB7 alternate function */
    GPIOB->MODER =
        (GPIOB->MODER &
        ~(GPIO_MODER_MODER6 | GPIO_MODER_MODER7)) |
        (GPIO_MODER_MODER6_1 | GPIO_MODER_MODER7_1);


    /* Open drain */
    GPIOB->OTYPER |=
        GPIO_OTYPER_OT_6 |
        GPIO_OTYPER_OT_7;


    /* Pullups */
    GPIOB->PUPDR =
        (GPIOB->PUPDR &
        ~(GPIO_PUPDR_PUPDR6 | GPIO_PUPDR_PUPDR7)) |
        (GPIO_PUPDR_PUPDR6_0 | GPIO_PUPDR_PUPDR7_0);


    /* AF4 */
    GPIOB->AFR[0] =
        (GPIOB->AFR[0] &
        ~((0xFUL << GPIO_AFRL_AFRL6_Pos) |
          (0xFUL << GPIO_AFRL_AFRL7_Pos))) |
        (4UL << GPIO_AFRL_AFRL6_Pos) |
        (4UL << GPIO_AFRL_AFRL7_Pos);


    I2C1->CR1 &= ~I2C_CR1_PE;

    I2C1->TIMINGR = 0x2000090E;

    I2C1->CR1 |= I2C_CR1_PE;
}


/* Write to register */
int i2cWriteReg(uint8_t addr, uint8_t reg, uint8_t val)
{
    I2C1->CR2 =
        (addr << 1) |
        (2UL << I2C_CR2_NBYTES_Pos) |
        I2C_CR2_START;


    if (waitSet(I2C_ISR_TXIS, 10)) return -1;
    I2C1->TXDR = reg;


    if (waitSet(I2C_ISR_TXIS, 10)) return -1;
    I2C1->TXDR = val;


    if (waitSet(I2C_ISR_TC, 10)) return -1;

    I2C1->CR2 |= I2C_CR2_STOP;

    return 0;
}


/* Read multiple bytes */
int i2cReadBurst(uint8_t addr, uint8_t reg, uint8_t* buf, uint8_t len)
{
    I2C1->CR2 =
        (addr << 1) |
        (1UL << I2C_CR2_NBYTES_Pos) |
        I2C_CR2_START;


    if (waitSet(I2C_ISR_TXIS, 10)) return -1;
    I2C1->TXDR = reg;


    if (waitSet(I2C_ISR_TC, 10)) return -1;


    I2C1->CR2 =
        (addr << 1) |
        I2C_CR2_RD_WRN |
        ((uint32_t)len << I2C_CR2_NBYTES_Pos) |
        I2C_CR2_START |
        I2C_CR2_AUTOEND;


    for (uint8_t i = 0; i < len; i++)
    {
        if (waitSet(I2C_ISR_RXNE, 10)) return -1;

        buf[i] = I2C1->RXDR;
    }

    return 0;
}


/* Initialise compass */
void compassInit(void)
{
    i2cInit();


    /* Enable GPIOE */
    RCC->AHBENR |= RCC_AHBENR_GPIOEEN;


    /* PE3/PE4 as outputs */
    GPIOE->MODER &= ~(0x3UL << (3 * 2));
    GPIOE->MODER |=  (0x1UL << (3 * 2));

    GPIOE->MODER &= ~(0x3UL << (4 * 2));
    GPIOE->MODER |=  (0x1UL << (4 * 2));


    /* Set CS high for I2C mode */
    GPIOE->ODR |= (1 << 3);
    GPIOE->ODR |= (1 << 4);


    for (volatile int i = 0; i < 10000; i++);


    if (i2cWriteReg(COMPASS_ADDR, CRA_REG_M, 0x14)) while (1);
    if (i2cWriteReg(COMPASS_ADDR, CRB_REG_M, 0x20)) while (1);
    if (i2cWriteReg(COMPASS_ADDR, MR_REG_M, 0x00)) while (1);
}


/* Read compass */
int compassRead(CompassData* data)
{
    uint8_t raw[6];


    if (i2cReadBurst(COMPASS_ADDR, OUT_X_H_M, raw, 6))
    {
        return -1;
    }


    data->x = (raw[0] << 8) | raw[1];
    data->z = (raw[2] << 8) | raw[3];
    data->y = (raw[4] << 8) | raw[5];


    data->heading =
        atan2((float)data->y, (float)data->x) *
        180.0f / 3.14159f;


    if (data->heading < 0)
    {
        data->heading += 360.0f;
    }


    data->timestamp = tick_ms;


    return 0;
}
