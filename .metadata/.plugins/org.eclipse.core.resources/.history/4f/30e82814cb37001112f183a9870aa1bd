#include "compass.h"
#include <math.h>


#define COMPASS_ADDR 0x3C

#define CRA_REG_M   0x00
#define CRB_REG_M   0x01
#define MR_REG_M    0x02
#define OUT_X_H_M   0x03


extern volatile uint32_t tick_ms;


/* Wait for I2C flag */
int waitSet(uint32_t flag, uint32_t timeout)
{
    uint32_t start = tick_ms;

    while (!(I2C1->ISR & flag))
    {
        if ((tick_ms - start) >= timeout)
        {
            return -1;
        }
    }

    return 0;
}


/* Initialise I2C */
void i2cInit(void)
{
    RCC->AHBENR |= RCC_AHBENR_GPIOBEN;
    RCC->APB1ENR |= RCC_APB1ENR_I2C1EN;


    GPIOB->MODER &= ~(0xFUL << 12);
    GPIOB->MODER |=  (0xAUL << 12);


    GPIOB->OTYPER |= (1 << 6) | (1 << 7);


    GPIOB->PUPDR &= ~(0xFUL << 12);
    GPIOB->PUPDR |=  (0x5UL << 12);


    GPIOB->AFR[0] &= ~(0xFFUL << 24);
    GPIOB->AFR[0] |=  (0x44UL << 24);


    I2C1->CR1 &= ~I2C_CR1_PE;

    I2C1->TIMINGR = 0x2000090E;

    I2C1->CR1 |= I2C_CR1_PE;
}


/* Write register */
int i2cWriteReg(uint8_t addr, uint8_t reg, uint8_t value)
{
    I2C1->ICR |= I2C_ICR_STOPCF;

    I2C1->CR2 =
        addr |
        (2 << I2C_CR2_NBYTES_Pos) |
        I2C_CR2_START;


    if (waitSet(I2C_ISR_TXIS, 10)) return -1;
    I2C1->TXDR = reg;


    if (waitSet(I2C_ISR_TXIS, 10)) return -1;
    I2C1->TXDR = value;


    if (waitSet(I2C_ISR_TC, 10)) return -1;

    I2C1->CR2 |= I2C_CR2_STOP;

    return 0;
}


/* Read burst */
int i2cReadBurst(uint8_t addr, uint8_t reg, uint8_t* buffer, uint8_t len)
{
    I2C1->ICR |= I2C_ICR_STOPCF;

    I2C1->CR2 =
        addr |
        (1 << I2C_CR2_NBYTES_Pos) |
        I2C_CR2_START;


    if (waitSet(I2C_ISR_TXIS, 10)) return -1;
    I2C1->TXDR = reg;


    if (waitSet(I2C_ISR_TC, 10)) return -1;


    I2C1->CR2 =
        addr |
        I2C_CR2_RD_WRN |
        (len << I2C_CR2_NBYTES_Pos) |
        I2C_CR2_START |
        I2C_CR2_AUTOEND;


    for (uint8_t i = 0; i < len; i++)
    {
        if (waitSet(I2C_ISR_RXNE, 10)) return -1;

        buffer[i] = I2C1->RXDR;
    }

    return 0;
}


/* Compass init */
void compassInit(void)
{
    i2cInit();


    RCC->AHBENR |= RCC_AHBENR_GPIOEEN;


    GPIOE->MODER &= ~(0xFUL << 6);
    GPIOE->MODER |=  (0x5UL << 6);


    GPIOE->ODR |= (1 << 3) | (1 << 4);


    for (volatile int i = 0; i < 10000; i++);


    i2cWriteReg(COMPASS_ADDR, CRA_REG_M, 0x14);
    i2cWriteReg(COMPASS_ADDR, CRB_REG_M, 0x20);
    i2cWriteReg(COMPASS_ADDR, MR_REG_M, 0x00);
}


/* Test communication */
int compassTestConnection(void)
{
    i2cInit();


    RCC->AHBENR |= RCC_AHBENR_GPIOEEN;


    GPIOE->MODER &= ~(0xFUL << 6);
    GPIOE->MODER |=  (0x5UL << 6);


    GPIOE->ODR |= (1 << 3) | (1 << 4);


    for (volatile int i = 0; i < 10000; i++);


    return i2cWriteReg(COMPASS_ADDR, CRA_REG_M, 0x14);
}


/* Read compass */
int compassRead(CompassData* data)
{
    uint8_t raw[6];

    if (i2cReadBurst(COMPASS_ADDR, OUT_X_H_M, raw, 6))
    {
        return -1;
    }


    data->x = (raw[0] << 8) | raw[1];
    data->z = (raw[2] << 8) | raw[3];
    data->y = (raw[4] << 8) | raw[5];


    data->heading =
        atan2((float)data->y, (float)data->x) *
        180.0f / 3.14159f;


    if (data->heading < 0)
    {
        data->heading += 360.0f;
    }


    data->timestamp = tick_ms;

    return 0;
}
