#include "stm32f303xc.h"
#include "compass.h"


/* Global millisecond timer */
volatile uint32_t tick_ms = 0;


/* SysTick interrupt */
void SysTick_Handler(void)
{
    tick_ms++;
}


/* Helper function to set GPIO mode */
void gpioSetMode(GPIO_TypeDef* port, uint8_t pin, uint32_t mode)
{
    port->MODER &= ~(0x3UL << (pin * 2));
    port->MODER |=  (mode << (pin * 2));
}


int main(void)
{
    /* Enable floating point */
    SCB->CPACR |= (0xFUL << 20);

    /* Start SysTick */
    SysTick_Config(8000);


    /* Enable GPIOE */
    RCC->AHBENR |= RCC_AHBENR_GPIOEEN;


    /* Set LEDs as outputs */
    for (int i = 8; i <= 15; i++)
    {
        gpioSetMode(GPIOE, i, 0x1);
    }


    /* Test compass communication */
    if (compassTestConnection() == 0)
    {
        GPIOE->ODR |= (1 << 8);     // SUCCESS LED
    }
    else
    {
        GPIOE->ODR |= (1 << 15);    // FAIL LED
    }


    while (1);
}
