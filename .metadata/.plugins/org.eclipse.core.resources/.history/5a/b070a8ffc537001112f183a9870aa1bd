#include "stm32f303xc.h"
#include "compass.h"


/* Global millisecond timer */
volatile uint32_t tick_ms = 0;


/* Global compass data structure */
CompassData compass;


/* SysTick interrupt runs every 1ms */
void SysTick_Handler(void)
{
    tick_ms++;
}


/* Set GPIO pin mode */
void gpioSetMode(GPIO_TypeDef* port, uint8_t pin, uint32_t mode)
{
    port->MODER &= ~(0x3UL << (pin * 2));
    port->MODER |=  (mode << (pin * 2));
}


/* Turn off all LEDs */
void clearLEDs(void)
{
    GPIOE->ODR &= ~(0xFF << 8);
}


int main(void)
{
    /* Enable floating point unit */
    SCB->CPACR |= (0xFUL << 20);


    /* Configure SysTick for 1ms interrupts */
    SysTick_Config(8000);


    /* Enable GPIOE clock */
    RCC->AHBENR |= RCC_AHBENR_GPIOEEN;


    /* Set PE8–PE15 as LED outputs */
    for (int i = 8; i <= 15; i++)
    {
        gpioSetMode(GPIOE, i, 0x1);
    }


    /* Turn on PE8 to show startup */
    GPIOE->ODR |= (1 << 8);


    /* Small startup delay */
    for (volatile int i = 0; i < 100000; i++);


    /* Initialise compass */
    compassInit();


    /* Turn on PE9 to show init passed */
    GPIOE->ODR |= (1 << 9);


    while (1)
    {
        if (compassRead(&compass) == 0)
        {
            clearLEDs();

            /* Light LED depending on heading */
            if (compass.heading < 45)
                GPIOE->ODR |= (1 << 8);

            else if (compass.heading < 90)
                GPIOE->ODR |= (1 << 9);

            else if (compass.heading < 135)
                GPIOE->ODR |= (1 << 10);

            else if (compass.heading < 180)
                GPIOE->ODR |= (1 << 11);

            else if (compass.heading < 225)
                GPIOE->ODR |= (1 << 12);

            else if (compass.heading < 270)
                GPIOE->ODR |= (1 << 13);

            else if (compass.heading < 315)
                GPIOE->ODR |= (1 << 14);

            else
                GPIOE->ODR |= (1 << 15);
        }
        else
        {
            /* Turn all LEDs on if read fails */
            GPIOE->ODR |= (0xFF << 8);
        }
    }
}
