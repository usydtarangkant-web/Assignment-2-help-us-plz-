#ifndef COMPASS_H                 // Prevent file being included multiple times
#define COMPASS_H

#include "stm32f303xc.h"         // Include STM32 register definitions


/* Structure to store all compass-related data */
typedef struct
{
    int16_t x;                   // Raw X-axis magnetic reading
    int16_t y;                   // Raw Y-axis magnetic reading
    int16_t z;                   // Raw Z-axis magnetic reading

    float heading;               // Calculated heading angle in degrees

    uint32_t timestamp;          // Time reading was taken (ms)

} CompassData;


/* Function declarations */
void compassInit(void);          // Initialise compass/I2C
int compassRead(CompassData* data); // Read compass data into struct

#endif
