#include "stm32f303xc.h"
#include "compass.h"


volatile uint32_t tick_ms = 0;


/* Global compass structure */
CompassData compass;


/* SysTick interrupt */
void SysTick_Handler(void)
{
    tick_ms++;
}


/* Set GPIO pin mode */
void gpioSetMode(GPIO_TypeDef* port, uint8_t pin, uint32_t mode)
{
    port->MODER &= ~(0x3UL << (pin * 2));
    port->MODER |=  (mode << (pin * 2));
}


/* Turn off all LEDs */
void clearLEDs(void)
{
    GPIOE->ODR &= ~(0xFF << 8);
}


/* Main program */
int main(void)
{
    SCB->CPACR |= (0xFUL << 20);

    SysTick_Config(8000);


    /* Enable GPIOE clock */
    RCC->AHBENR |= RCC_AHBENR_GPIOEEN;


    /* Set PE8–PE15 as outputs */
    for (int i = 8; i <= 15; i++)
    {
        gpioSetMode(GPIOE, i, 0x1);
    }


    compassInit();


    while (1)
    {
        if (compassRead(&compass) == 0)
        {
            clearLEDs();

            if (compass.heading < 45)
                GPIOE->ODR |= (1 << 8);

            else if (compass.heading < 90)
                GPIOE->ODR |= (1 << 9);

            else if (compass.heading < 135)
                GPIOE->ODR |= (1 << 10);

            else if (compass.heading < 180)
                GPIOE->ODR |= (1 << 11);

            else if (compass.heading < 225)
                GPIOE->ODR |= (1 << 12);

            else if (compass.heading < 270)
                GPIOE->ODR |= (1 << 13);

            else if (compass.heading < 315)
                GPIOE->ODR |= (1 << 14);

            else
                GPIOE->ODR |= (1 << 15);
        }
        else
        {
            /* If compass read fails, turn ALL LEDs on */
            GPIOE->ODR |= (0xFF << 8);
        }
    }
}
