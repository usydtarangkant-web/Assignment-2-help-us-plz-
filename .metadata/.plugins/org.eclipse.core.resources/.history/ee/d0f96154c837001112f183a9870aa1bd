#include "compass.h"
#include <math.h>


/* Magnetometer I2C address (8-bit shifted form) */
#define COMPASS_ADDR 0x3C


/* Magnetometer registers */
#define CRA_REG_M   0x00
#define CRB_REG_M   0x01
#define MR_REG_M    0x02
#define OUT_X_H_M   0x03


/* Global millisecond timer from main.c */
extern volatile uint32_t tick_ms;


/* Wait for I2C flag with timeout */
int waitSet(uint32_t flag, uint32_t timeout)
{
    uint32_t start = tick_ms;

    while (!(I2C1->ISR & flag))
    {
        if ((tick_ms - start) >= timeout)
        {
            return -1;
        }
    }

    return 0;
}


/* Initialise I2C1 peripheral */
// void i2cInit(void) //
{
    /* Enable clocks */
    RCC->AHBENR |= RCC_AHBENR_GPIOBEN;
    RCC->APB1ENR |= RCC_APB1ENR_I2C1EN;


    /* PB6/PB7 alternate function mode */
    GPIOB->MODER &= ~(0xFUL << 12);
    GPIOB->MODER |=  (0xAUL << 12);


    /* Open drain */
    GPIOB->OTYPER |= (1 << 6) | (1 << 7);


    /* Pull-up resistors */
    GPIOB->PUPDR &= ~(0xFUL << 12);
    GPIOB->PUPDR |=  (0x5UL << 12);


    /* Alternate function 4 */
    GPIOB->AFR[0] &= ~(0xFFUL << 24);
    GPIOB->AFR[0] |=  (0x44UL << 24);


    /* Disable I2C before config */
    I2C1->CR1 &= ~I2C_CR1_PE;


    /* 100kHz timing */
    I2C1->TIMINGR = 0x2000090E;


    /* Enable I2C */
    I2C1->CR1 |= I2C_CR1_PE;
}


/* Write single register */
int i2cWriteReg(uint8_t addr, uint8_t reg, uint8_t value)
{
    /* Clear old flags */
    I2C1->ICR |= I2C_ICR_STOPCF;


    /* Setup write transaction */
    I2C1->CR2 =
        addr |
        (2 << I2C_CR2_NBYTES_Pos) |
        I2C_CR2_START;


    if (waitSet(I2C_ISR_TXIS, 10)) return -1;
    I2C1->TXDR = reg;


    if (waitSet(I2C_ISR_TXIS, 10)) return -1;
    I2C1->TXDR = value;


    if (waitSet(I2C_ISR_TC, 10)) return -1;


    I2C1->CR2 |= I2C_CR2_STOP;

    return 0;
}


/* Read multiple bytes */
int i2cReadBurst(uint8_t addr, uint8_t reg, uint8_t* buffer, uint8_t len)
{
    /* Clear old flags */
    I2C1->ICR |= I2C_ICR_STOPCF;


    /* Send register address first */
    I2C1->CR2 =
        addr |
        (1 << I2C_CR2_NBYTES_Pos) |
        I2C_CR2_START;


    if (waitSet(I2C_ISR_TXIS, 10)) return -1;
    I2C1->TXDR = reg;


    if (waitSet(I2C_ISR_TC, 10)) return -1;


    /* Restart in read mode */
    I2C1->CR2 =
        addr |
        I2C_CR2_RD_WRN |
        (len << I2C_CR2_NBYTES_Pos) |
        I2C_CR2_START |
        I2C_CR2_AUTOEND;


    for (uint8_t i = 0; i < len; i++)
    {
        if (waitSet(I2C_ISR_RXNE, 10)) return -1;

        buffer[i] = I2C1->RXDR;
    }

    return 0;
}


/* Initialise compass */
void compassInit(void)
{
    i2cInit();


    /* Enable GPIOE clock */
    RCC->AHBENR |= RCC_AHBENR_GPIOEEN;


    /* PE3/PE4 output mode */
    GPIOE->MODER &= ~(0xFUL << 6);
    GPIOE->MODER |=  (0x5UL << 6);


    /* Set CS pins high */
    GPIOE->ODR |= (1 << 3) | (1 << 4);


    /* Small delay */
    for (volatile int i = 0; i < 10000; i++);


    /* Configure compass */
    if (i2cWriteReg(COMPASS_ADDR, CRA_REG_M, 0x14)) while (1);
    if (i2cWriteReg(COMPASS_ADDR, CRB_REG_M, 0x20)) while (1);
    if (i2cWriteReg(COMPASS_ADDR, MR_REG_M, 0x00)) while (1);
}


/* Read compass values */
int compassRead(CompassData* data)
{
    uint8_t raw[6];


    if (i2cReadBurst(COMPASS_ADDR, OUT_X_H_M, raw, 6))
    {
        return -1;
    }


    /* Combine bytes */
    data->x = (raw[0] << 8) | raw[1];
    data->z = (raw[2] << 8) | raw[3];
    data->y = (raw[4] << 8) | raw[5];


    /* Calculate heading */
    data->heading =
        atan2((float)data->y, (float)data->x) *
        180.0f / 3.14159f;


    if (data->heading < 0)
    {
        data->heading += 360.0f;
    }


    /* Save timestamp */
    data->timestamp = tick_ms;


    return 0;
}
