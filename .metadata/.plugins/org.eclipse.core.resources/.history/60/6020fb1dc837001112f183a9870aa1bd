#include "stm32f303xc.h"

void gpioSetMode(GPIO_TypeDef* port, uint8_t pin, uint32_t mode)
{
    port->MODER &= ~(0x3UL << (pin * 2));
    port->MODER |=  (mode << (pin * 2));
}

void i2cInit(void)
{
    RCC->AHBENR |= RCC_AHBENR_GPIOBEN;
    RCC->APB1ENR |= RCC_APB1ENR_I2C1EN;

    GPIOB->MODER &= ~(0xFUL << 12);
    GPIOB->MODER |=  (0xAUL << 12);

    GPIOB->OTYPER |= (1 << 6) | (1 << 7);

    GPIOB->PUPDR &= ~(0xFUL << 12);
    GPIOB->PUPDR |=  (0x5UL << 12);

    GPIOB->AFR[0] &= ~(0xFFUL << 24);
    GPIOB->AFR[0] |=  (0x44UL << 24);

    I2C1->CR1 &= ~I2C_CR1_PE;
    I2C1->TIMINGR = 0x2000090E;
    I2C1->CR1 |= I2C_CR1_PE;
}

int i2cCheckAddress(uint8_t addr)
{
    I2C1->ICR |= I2C_ICR_STOPCF | I2C_ICR_NACKCF;

    I2C1->CR2 =
        (addr << 1) |
        I2C_CR2_START |
        I2C_CR2_AUTOEND;

    for (volatile int i = 0; i < 10000; i++);

    if (I2C1->ISR & I2C_ISR_NACKF)
    {
        return 0;
    }

    return 1;
}

int main(void)
{
    RCC->AHBENR |= RCC_AHBENR_GPIOEEN;

    for (int i = 8; i <= 15; i++)
    {
        gpioSetMode(GPIOE, i, 0x1);
    }

    i2cInit();

    while (1)
    {
        GPIOE->ODR &= ~(0xFF << 8);

        for (uint8_t addr = 1; addr < 128; addr++)
        {
            if (i2cCheckAddress(addr))
            {
                GPIOE->ODR |= (1 << 8);
                while (1);
            }
        }

        GPIOE->ODR |= (1 << 15);
        while (1);
    }
}
