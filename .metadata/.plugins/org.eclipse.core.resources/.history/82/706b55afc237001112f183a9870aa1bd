#include "stm32f303xc.h"
#include "compass.h"

volatile uint32_t tick_ms = 0;


void SysTick_Handler(void)
{
    tick_ms++;
}


int main(void)
{
    SCB->CPACR |= (0xFUL << 20);

    SysTick_Config(8000);

    CompassData compass;

    compassInit();

    while (1)
    {
        compassRead(&compass);
    }
}
