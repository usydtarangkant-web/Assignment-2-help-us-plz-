#include "compass.h"
#include "stm32f303xc.h"

/* -----------------------------
   LSM303DLHC Magnetometer Info
------------------------------*/
#define COMPASS_ADDR     (0x1E << 1)

#define CRA_REG_M        0x00
#define CRB_REG_M        0x01
#define MR_REG_M         0x02

#define OUT_X_H_M        0x03

/* -----------------------------
   Low Level I2C Functions
------------------------------*/

static void I2C_WriteRegister(uint8_t reg, uint8_t value)
{
    while (!(I2C1->ISR & I2C_ISR_TXIS));

    I2C1->CR2 =
        (COMPASS_ADDR << 1) |
        (2 << 16) |
        I2C_CR2_START |
        I2C_CR2_AUTOEND;

    while (!(I2C1->ISR & I2C_ISR_TXIS));
    I2C1->TXDR = reg;

    while (!(I2C1->ISR & I2C_ISR_TXIS));
    I2C1->TXDR = value;

    while (!(I2C1->ISR & I2C_ISR_STOPF));
    I2C1->ICR |= I2C_ICR_STOPCF;
}

static void I2C_ReadRegisters(uint8_t reg, uint8_t *buffer, uint8_t length)
{
    while (!(I2C1->ISR & I2C_ISR_TXIS));

    /* Send register address */
    I2C1->CR2 =
        (COMPASS_ADDR << 1) |
        (1 << 16) |
        I2C_CR2_START;

    while (!(I2C1->ISR & I2C_ISR_TXIS));
    I2C1->TXDR = reg;

    while (!(I2C1->ISR & I2C_ISR_TC));

    /* Restart for read */
    I2C1->CR2 =
        (COMPASS_ADDR << 1) |
        I2C_CR2_RD_WRN |
        (length << 16) |
        I2C_CR2_START |
        I2C_CR2_AUTOEND;

    for (int i = 0; i < length; i++)
    {
        while (!(I2C1->ISR & I2C_ISR_RXNE));
        buffer[i] = I2C1->RXDR;
    }

    while (!(I2C1->ISR & I2C_ISR_STOPF));
    I2C1->ICR |= I2C_ICR_STOPCF;
}

/* -----------------------------
   Public Functions
------------------------------*/

void Compass_Init(void)
{
    /* Enable GPIOB clock */
    RCC->AHBENR |= RCC_AHBENR_GPIOBEN;

    /* Enable I2C1 clock */
    RCC->APB1ENR |= RCC_APB1ENR_I2C1EN;

    /* PB6 = SCL, PB7 = SDA Alternate Function */
    GPIOB->MODER &= ~(3 << (6*2));
    GPIOB->MODER &= ~(3 << (7*2));

    GPIOB->MODER |= (2 << (6*2));
    GPIOB->MODER |= (2 << (7*2));

    GPIOB->AFR[0] |= (4 << (6*4));
    GPIOB->AFR[0] |= (4 << (7*4));

    GPIOB->OTYPER |= (1 << 6);
    GPIOB->OTYPER |= (1 << 7);

    GPIOB->PUPDR |= (1 << (6*2));
    GPIOB->PUPDR |= (1 << (7*2));

    /* Disable I2C before config */
    I2C1->CR1 &= ~I2C_CR1_PE;

    /* Timing config for 100kHz */
    I2C1->TIMINGR = 0x2000090E;

    /* Enable I2C */
    I2C1->CR1 |= I2C_CR1_PE;

    /* Configure Compass */
    I2C_WriteRegister(CRA_REG_M, 0x14);  // 30Hz output
    I2C_WriteRegister(CRB_REG_M, 0x20);  // Gain
    I2C_WriteRegister(MR_REG_M, 0x00);   // Continuous conversion
}

void Compass_Read(CompassData *data)
{
    uint8_t raw[6];

    I2C_ReadRegisters(OUT_X_H_M, raw, 6);

    data->x = (raw[0] << 8) | raw[1];
    data->z = (raw[2] << 8) | raw[3];
    data->y = (raw[4] << 8) | raw[5];
}
